# Copy to .env and fill in real values. .env is gitignored.
# Get an API key from Benchling profile -> API keys.

# Test tenant (default)
BENCHLING_TEST_TENANT_URL=https://yourtenant.benchling.com
BENCHLING_TEST_API_KEY=sk_test_xxxxxxxxxxxx

# Prod tenant (used when --prod is passed)
BENCHLING_PROD_TENANT_URL=https://yourtenant.benchling.com
BENCHLING_PROD_API_KEY=sk_prod_xxxxxxxxxxxx
